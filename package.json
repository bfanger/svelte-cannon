{
  "name": "svelte-cannon",
  "description": "Declarative Svelte components for the cannon-es physics engine",
  "version": "0.8.0",
  "license": "MIT",
  "homepage": "https://svelte-cannon.bfanger.nl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bfanger/svelte-cannon.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "package": "svelte-package",
    "lint": "svelte-kit sync && concurrently -c \"#c596c7\",\"#676778\",\"#4b32c3\",\"#fafafa\" --kill-others-on-fail \"npm:lint:*\"",
    "lint:prettier": "prettier --check .",
    "lint:svelte-check": "svelte-check --fail-on-warnings",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:stylelint": "stylelint --max-warnings=0 \"src/**/*.{css,svelte}\"",
    "format": "eslint --fix && stylelint --fix \"src/**/*.{css,svelte}\" && prettier --write .",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "npm run test -- --watch"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --max-warnings 0 --no-ignore",
      "sh -c 'tsc -p tsconfig.json --noEmit'"
    ],
    "*.(c)?js": [
      "eslint --max-warnings 0 --no-ignore"
    ],
    "*.svelte": [
      "eslint --max-warnings 0 --no-ignore",
      "svelte-check --fail-on-warnings",
      "prettier --check"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "cannon-es": "*",
    "svelte": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@types/three": "0.135.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cannon-es": "^0.20.0",
    "cannon-es-debugger": "^1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-cubed": "^0.2.1",
    "three": "0.135.0",
    "typescript": "6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-devtools-json": "^1.1.1",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
